# Solana RPC used for submits and reads. A dedicated/staked RPC lands high-frequency
# transactions far more reliably than the public endpoint.
RPC_URL=https://api.devnet.solana.com
# Optional websocket endpoint for `watch` (derived from RPC_URL when omitted).
# WS_URL=wss://api.devnet.solana.com

# Solana CLI keypair of the pusher. It pays transaction fees, owns the subscription
# (or is a delegate of one) and becomes the `submitter` of every feed it writes.
KEYPAIR_PATH=~/.config/solana/id.json

# Feed set to drive (see config/feeds.json).
FEEDS_FILE=config/feeds.json

# Optional gateway override. Defaults to the gateway baked into the installed SDK profile.
# GATEWAY_URL=https://gateway.molpha.io
# GATEWAY_AUTHORITY=<gateway base58 pubkey>   # pin it; otherwise read from GET /v1/info

# Commitment the pusher waits for on each submit: processed | confirmed | finalized.
COMMITMENT=confirmed

# Priority fee in micro-lamports per CU, or "auto" (p75 of recent fees on the feed), or 0.
PRIORITY_FEE=auto
